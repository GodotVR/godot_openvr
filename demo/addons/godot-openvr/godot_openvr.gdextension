[configuration]

entry_symbol = "openvr_library_init"
compatibility_minimum = 4.1

[libraries]

linux.x86_64.debug="bin/x11/libgodot_openvr_debug.so"
linux.x86_64.release="bin/x11/libgodot_openvr_release.so"
windows.x86_64.debug="bin/win64/libgodot_openvr_debug.dll"
windows.x86_64.release="bin/win64/libgodot_openvr_release.dll"

[dependencies]

linux.x86_64 = {
	"bin/x11/libopenvr_api.so": ""
}
windows.x86_64 = {
	"bin/win64/openvr_api.dll": ""
}
